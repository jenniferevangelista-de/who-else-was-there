{
  "name": "pulse-of-the-dead",
  "version": "0.1.0",
  "private": true,
  "description": "A cute, spooky ghost hunt where the evidence is a heartbeat. Presage SmartSpectra reads every face in a recording; the one with no pulse is the case.",
  "license": "MIT",
  "author": "Jennifer Evangelista",
  "type": "module",
  "main": "app/main.cjs",
