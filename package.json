    "replay": "npm run build && electron . --replay",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@smartspectra/node-sdk": "3.4.0"
  },
  "devDependencies": {
    "@fontsource/creepster": "5.3.0",
    "@fontsource/fredoka": "5.3.0",
    "@fontsource/vt323": "5.3.0",
    "electron": "43.2.0",
    "esbuild": "0.25.12"
  }
